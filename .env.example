# ==========================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# --- Supabase (Data & Auth) ---
# Supabase Project URL (Dibutuhkan untuk Client dan Server)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable Key (Aman di frontend karena RLS aktif)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# --- Google Gemini AI ---
# Gemini API Key (JANGAN menggunakan VITE_ prefix. Hanya server Vercel yang membacanya)
# AI Assistant tidak dapat beroperasi jika ini tidak ada.
GEMINI_API_KEY="your-gemini-api-key"

# --- System Settings ---
# Domain URL utama aplikasi
SITE_URL="https://annisanurprabawaportfolio.com"
